  <!-- EN: Trait {0} -->
  <BTG_ScenPart_TraitNumbered>特性{0}</BTG_ScenPart_TraitNumbered>
  <!-- EN: Choose trait... -->
  <BTG_ScenPart_ChooseTrait>选择特性...</BTG_ScenPart_ChooseTrait>
  <!-- EN: Add trait... -->
  <BTG_ScenPart_AddTrait>添加特性...</BTG_ScenPart_AddTrait>
  <!-- Button text when the starting apparel color matches no named color -->
  <!-- EN: Custom color -->
  <BTG_ScenPart_CustomColor>自定义颜色</BTG_ScenPart_CustomColor>
  <!-- Scenario summary intro; the per-faction goodwill entries are listed under it -->
  <!-- EN: Start with goodwill -->
  <BTG_ScenPart_FactionGoodwill_Summary>开局好感度</BTG_ScenPart_FactionGoodwill_Summary>
  <!-- {0} = shuttle label -->
  <!-- EN: {0} (not launchable) -->
  <BTG_ScenPart_NotLaunchable>{0}（无法发射）</BTG_ScenPart_NotLaunchable>
  <!-- Row label beside the starting fuel percentage field -->
  <!-- EN: Fuel % -->
  <BTG_ScenPart_FuelPercent>燃料%</BTG_ScenPart_FuelPercent>
  <!-- Row label beside the shuttle paint color picker -->
  <!-- EN: Paint -->
  <BTG_ScenPart_Paint>粉饰</BTG_ScenPart_Paint>
