<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Odyssey pt-BR GoldInlay is the template: its label is a lowercase noun phrase
       ("incrustacao de ouro") and the second sentence of its description is reused
       verbatim. traitAdjectives follow vanilla pt-BR's own pattern for GoldInlay - a bare
       noun ("ouro") plus a masculine-singular adjective ("dourado") - because
       NamerUniqueWeapon pt-BR preposes the adjective under a hardcoded masculine
       "O [weapon_adjective] [weapon_type]" and so cannot agree with the weapon noun's
       real gender. -->
  <!-- EN: silver inlay -->
  <SilverInlay.label>incrustação de prata</SilverInlay.label>
  <!-- EN: This weapon is inlaid with silver. Traders will pay more for it. -->
  <SilverInlay.description>Esta arma possui incrustações de prata. Comerciantes pagarão mais por ela.</SilverInlay.description>
  <!-- EN: silver -->
  <SilverInlay.traitAdjectives.0>prata</SilverInlay.traitAdjectives.0>
  <!-- EN: silvered -->
  <SilverInlay.traitAdjectives.1>prateado</SilverInlay.traitAdjectives.1>
  <!-- EN: gleaming -->
  <SilverInlay.traitAdjectives.2>reluzente</SilverInlay.traitAdjectives.2>
  <!-- EN: argent -->
  <SilverInlay.traitAdjectives.3>argênteo</SilverInlay.traitAdjectives.3>
  <!-- EN: fine -->
  <SilverInlay.traitAdjectives.4>refinado</SilverInlay.traitAdjectives.4>

</LanguageData>
