  <!-- EN: Docked vessel -->
  <BTG_DockedVessel>정박 중인 선박</BTG_DockedVessel>
  <!-- EN: {0}: {1} (departs in {2} days) -->
  <BTG_DockedVesselDeparts>{0}: {1} ({2}일 후 출발)</BTG_DockedVesselDeparts>

  <!-- ========== MOD SETTINGS: SECTION HEADERS ========== -->
  <!-- EN: Trading -->
  <BTG_Settings_Trading>거래</BTG_Settings_Trading>
  <!-- EN: Map Generation -->
  <BTG_Settings_MapGeneration>지도 생성</BTG_Settings_MapGeneration>
  <!-- EN: Defenders -->
  <BTG_Settings_Defenders>방어군</BTG_Settings_Defenders>
  <!-- EN: Defender Resupply -->
  <BTG_Settings_Resupply>방어군 보급</BTG_Settings_Resupply>
  <!-- EN: Reset to defaults -->
  <BTG_Settings_ResetToDefaults>기본값 복원</BTG_Settings_ResetToDefaults>

  <!-- ========== MOD SETTINGS: TRADER ROTATION ========== -->
  <!-- EN: Trader rotation interval: {0} days -->
  <BTG_Settings_TraderRotationInterval>상인 교체 주기: {0}일</BTG_Settings_TraderRotationInterval>
  <!-- EN: (Vanilla) -->
  <BTG_Settings_Vanilla>(기본값)</BTG_Settings_Vanilla>
  <!-- EN: (BTG Recommended) -->
  <BTG_Settings_BTGRecommended>(BTG 권장)</BTG_Settings_BTGRecommended>
  <!-- EN: How often orbital traders rotate at TradersGuild settlements. -->
  <BTG_Settings_TraderRotationDesc1>교역 조합 정착지에서 궤도 상인이 교체되는 주기입니다.</BTG_Settings_TraderRotationDesc1>
  <!-- EN: Lower values = more variety, but less time to reach distant settlements. -->
  <BTG_Settings_TraderRotationDesc2>값이 낮을수록 상인이 다양해지지만, 먼 정착지까지 갈 시간이 줄어듭니다.</BTG_Settings_TraderRotationDesc2>

  <!-- ========== MOD SETTINGS: CUSTOM LAYOUTS ========== -->
  <!-- EN: Use custom settlement map generator -->
  <BTG_Settings_UseCustomLayouts>전용 정착지 지도 생성기 사용</BTG_Settings_UseCustomLayouts>
  <!-- EN: Generate TradersGuild settlements with less abandoned-looking aesthetics.\nDisable if using other map generation mods or prefer vanilla layouts. -->
  <BTG_Settings_UseCustomLayoutsDesc>교역 조합 정착지를 버려진 느낌이 덜한 모습으로 생성합니다.\n다른 지도 생성 모드를 사용하거나 기본 배치를 선호한다면 해제하세요.</BTG_Settings_UseCustomLayoutsDesc>

  <!-- ========== MOD SETTINGS: CARGO VAULT ========== -->
  <!-- EN: Enable cargo vault access -->
  <BTG_Settings_EnableCargoVault>화물 금고 접근 허용</BTG_Settings_EnableCargoVault>
  <!-- EN: When enabled, cargo vault hatches in shuttle bays can be hacked to access trade inventory.\nWhen disabled, cargo vaults spawn sealed and inaccessible.\nOnly affects newly generated settlements. -->
  <BTG_Settings_EnableCargoVaultDesc>활성화하면 왕복선 격납고의 화물 금고 해치를 해킹하여 교역 물품에 접근할 수 있습니다.\n비활성화하면 화물 금고가 밀폐된 채로 생성되어 접근할 수 없습니다.\n새로 생성되는 정착지에만 적용됩니다.</BTG_Settings_EnableCargoVaultDesc>

  <!-- ========== MOD SETTINGS: SENTRY DRONES ========== -->
  <!-- EN: Additional sentry drone presence: {0}% -->
  <BTG_Settings_SentryDronePresence>추가 센트리 드론 배치: {0}%</BTG_Settings_SentryDronePresence>
  <!-- EN: Factor of threat points used for additional patrolling sentry drones. -->
  <BTG_Settings_SentryDroneDesc>순찰하는 센트리 드론을 추가로 배치하는 데 사용할 위협 지수의 비율입니다.</BTG_Settings_SentryDroneDesc>

  <!-- ========== MOD SETTINGS: DEFENDER AI ========== -->
  <!-- EN: Entrenched defender AI -->
  <BTG_Settings_EntrenchedDefenders>농성형 방어군 AI</BTG_Settings_EntrenchedDefenders>
  <!-- EN: Defenders hold the settlement structure and never assault or chase intruders into vacuum, foraging and resting inside their base.\nDisable to revert to vanilla defender AI (defends the base, then assaults).\nDecided when a settlement is entered; only affects settlements entered afterwards. -->
  <BTG_Settings_EntrenchedDefendersDesc>방어군이 정착지 구조물을 지키며, 침입자를 쫓아 진공으로 돌격하지 않고 기지 안에서 식사하고 휴식합니다.\n해제하면 기본 방어군 AI(기지를 지킨 뒤 돌격)로 되돌아갑니다.\n정착지에 진입할 때 결정되며, 이후에 진입하는 정착지에만 적용됩니다.</BTG_Settings_EntrenchedDefendersDesc>

  <!-- ========== MOD SETTINGS: DEFENDER THREAT POINTS ========== -->
  <!-- EN: Scale defenders to colony threat level -->
  <BTG_Settings_ScaleDefenders>내 정착지 위협 수준에 맞춰 방어군 조정</BTG_Settings_ScaleDefenders>
  <!-- EN: Initial defender strength scales with your colony's wealth and difficulty, like raids do (never below the vanilla baseline).\nVanilla gives every settlement a similar fixed-strength garrison regardless of your progress. -->
  <BTG_Settings_ScaleDefendersDesc>초기 방어군 전력이 습격과 마찬가지로 내 정착지의 자산과 난이도에 따라 조정됩니다(기본 기준치 아래로는 내려가지 않습니다).\n기본 설정에서는 진행 상황과 관계없이 모든 정착지에 비슷한 고정 전력의 수비대가 배치됩니다.</BTG_Settings_ScaleDefendersDesc>
  <!-- EN: Defender threat points multiplier: {0}x -->
  <BTG_Settings_ThreatMultiplier>방어군 위협 지수 배율: {0}배</BTG_Settings_ThreatMultiplier>
  <!-- EN: Higher values = more/stronger initial defenders when entering settlements. -->
  <BTG_Settings_ThreatMultiplierDesc>값이 높을수록 정착지에 진입할 때 초기 방어군이 많아지거나 강해집니다.</BTG_Settings_ThreatMultiplierDesc>

  <!-- ========== MOD SETTINGS: GARRISON DEFEAT ========== -->
  <!-- 수비대 is the mod-decided word for a garrison force (vanilla ko AncientGarrison is 주둔지, a place). -->
  <!-- 포탑 is Core ko turret vocabulary (보안 포탑, 자동 포탑); 메카노이드 is Core ko. -->
  <!-- No josa markers needed: {0} is followed by % only. -->
  <!-- {0} = percentage -->
  <!-- EN: Garrison defeat threshold: {0}% -->
  <BTG_Settings_SecurityDefeatThreshold>수비대 패배 기준: {0}%</BTG_Settings_SecurityDefeatThreshold>
  <!-- EN: How much of a settlement's or smugglers den's original defence force must be downed before the guild gives up the map.\nCounts defending guards and patrolling sentry drones, not turrets or worker mechs.\n100% means fighting to the last defender. -->
  <BTG_Settings_SecurityDefeatThresholdDesc>정착지나 밀수업자 소굴의 초기 방어 전력이 얼마나 쓰러져야 조합이 그 지도를 포기하는지를 정합니다.\n방어를 맡은 경비병과 순찰 중인 센트리 드론만 세며, 포탑이나 작업용 메카노이드는 세지 않습니다.\n100%는 마지막 한 명까지 싸운다는 뜻입니다.</BTG_Settings_SecurityDefeatThresholdDesc>

  <!-- ========== MOD SETTINGS: LIFE SUPPORT ========== -->
  <!-- EN: LifeSupportUnit power output: {0}W -->
  <BTG_Settings_LifeSupportPower>생명 유지 장치 전력 출력: {0}W</BTG_Settings_LifeSupportPower>
  <!-- EN: Power output from orbital LifeSupportUnits. -->
  <BTG_Settings_LifeSupportDesc>궤도 생명 유지 장치의 전력 출력입니다.</BTG_Settings_LifeSupportDesc>

  <!-- ========== MOD SETTINGS: MOD NAME ========== -->
  <!-- EN: Better Traders Guild -->
  <BTG_Settings_ModName>교역 조합 확장판</BTG_Settings_ModName>

  <!-- ========== DEFENDER RESUPPLY ========== -->
  <!-- EN: The garrison's distress call has drawn a response. -->
  <BTG_ResupplyDropArrived>수비대의 구조 요청에 응답이 도착했습니다.</BTG_ResupplyDropArrived>

  <!-- ========== MOD SETTINGS: DEFENDER RESUPPLY ========== -->
  <!-- EN: Resupply meals per defender: {0} -->
  <BTG_Settings_ResupplyMealsPerDefender>방어군 1명당 보급 식량: {0}</BTG_Settings_ResupplyMealsPerDefender>
  <!-- EN: Survival meals dropped per surviving defender each time a starving garrison calls in a resupply. -->
  <BTG_Settings_ResupplyMealsPerDefenderDesc>굶주린 수비대가 보급을 요청할 때마다 생존한 방어군 1명당 투하되는 보존 식량의 수입니다.</BTG_Settings_ResupplyMealsPerDefenderDesc>
  <!-- EN: Call in reinforcements -->
  <BTG_Settings_ResupplyTriggersRaid>증원군 요청</BTG_Settings_ResupplyTriggersRaid>
  <!-- EN: When a resupply call succeeds, also summon a drop-pod raid of settlement reinforcements to hunt your pawns. They arrive as a normal raid rather than as bounded defenders. Small chance they drop right on top of your pawns in a smaller group. Only fires while the settlement is hostile. -->
  <BTG_Settings_ResupplyTriggersRaidDesc>보급 요청이 성공하면 정착지 증원군의 수송 포드 습격도 함께 발생시켜 내 캐릭터를 추격하게 합니다. 이들은 제한된 방어군이 아니라 일반 습격으로 도착합니다. 낮은 확률로 더 적은 인원이 내 캐릭터 바로 위에 낙하하기도 합니다. 정착지가 적대 상태일 때만 발생합니다.</BTG_Settings_ResupplyTriggersRaidDesc>

  <!-- ========== CARGO VAULT HATCH ========== -->
  <!-- EN: Relock cargo vault -->
  <BTG_CargoVaultHatch_RelockLabel>화물 금고 재잠금</BTG_CargoVaultHatch_RelockLabel>
  <!-- EN: Relock the cargo vault. Contents will be returned to station inventory. -->
  <BTG_CargoVaultHatch_RelockDesc>화물 금고를 다시 잠급니다. 내용물은 정거장 재고로 반환됩니다.</BTG_CargoVaultHatch_RelockDesc>

  <!-- ========== SMUGGLER'S DEN QUEST ========== -->
  <!-- EN: Cargo claim: {0} -->
  <BTG_Reward_CargoClaim>화물 인수권: {0}</BTG_Reward_CargoClaim>
  <!-- EN: Cargo claim: unknown manifest -->
  <BTG_Reward_CargoClaim_Unknown>화물 인수권: 미상 화물 목록</BTG_Reward_CargoClaim_Unknown>

  <!-- ========== ONE-TIME FIX NOTIFICATIONS ========== -->
  <!-- All three injected arguments are Colorize()d faction/mod names, i.e. arbitrary
       text wrapped in colour tags. Rather than mark a josa off a value whose final
       syllable is unknowable, each placeholder is followed by a literal noun (세력)
       that carries the particle itself - so the particles here are fixed and correct
       whatever name is injected. -->
  <!-- EN: {0}: Update -->
  <BTG_EmpireRelationFix_DialogTitle>{0}: 업데이트</BTG_EmpireRelationFix_DialogTitle>
  <!-- EN: A bug in a previous version of {2} caused {0} to be permanently hostile when playing as {1}.\n\nThis has been corrected.\n\nWould you like to reset your relations with {0} to neutral, or remain hostile for now? -->
  <BTG_EmpireRelationFix_DialogBody>{2}의 이전 버전 버그로 인해 {1} 세력으로 플레이할 때 {0} 세력이 영구 적대 상태가 되었습니다.\n\n이 문제는 수정되었습니다.\n\n{0} 세력과의 관계를 중립으로 되돌리시겠습니까, 아니면 당분간 적대 상태로 두시겠습니까?</BTG_EmpireRelationFix_DialogBody>
  <!-- EN: Reset to neutral -->
  <BTG_EmpireRelationFix_Neutral>중립으로 되돌리기</BTG_EmpireRelationFix_Neutral>
  <!-- EN: Remain hostile for now -->
  <BTG_EmpireRelationFix_LeaveHostile>당분간 적대 상태 유지</BTG_EmpireRelationFix_LeaveHostile>

  <!-- ========== SCENARIO: GAME START DIALOGS ========== -->
  <!-- EN: Your guild transponder is dead, and the mechhive tracks your signal. Its terrifying murder machines will arrive soon. Gather the valuable gravlite panels, then use your gravship to flee to a safe location on the planet below.\n\nTo launch the gravship, select the pilot console, then select the launch command.\n\nOn the world map, select 'view planet' to choose a landing spot on the planet.\n\nThe Guild won't help you, and wherever you go, the mechanoids will eventually find you. To stop them, you must find and defeat the mechhive itself. -->
  <BTG_GameStartDialog_ExiledTraders>조합 발신기가 꺼졌고, 메카노이드 군락이 당신의 신호를 추적하고 있습니다. 무시무시한 살인 기계들이 곧 도착할 것입니다. 귀중한 중력감응판을 수습한 뒤, 중력부양선을 이용해 행성 위의 안전한 장소로 도망치세요.\n\n중력부양선을 발사하려면 조종석을 선택한 후 발사 명령을 실행하세요.\n\n세계 지도에서 '행성 보기'를 선택하여 착륙 지점을 정하세요.\n\n조합은 당신을 돕지 않으며, 당신이 어디로 향해도 메카노이드가 결국 당신을 찾아올 것입니다. 메카노이드를 멈추려면, 반드시 메카노이드 군락 자체를 찾아내어 격파해야 합니다.</BTG_GameStartDialog_ExiledTraders>
  <!-- EN: The trade frequency chirps its farewell as your shuttle clears the orbital ring. Years of guild runs, split margins, and crowded docking bays - all behind you. No hard feelings. Just bigger plans.\n\nYour shuttle burns toward unclaimed wilds, yet silver alone won't keep you alive out here. The guild will still deal with old friends - but first, you need a home. -->
  <BTG_GameStartDialog_IndependentTraders>왕복선이 궤도 고리를 벗어나자 교역 주파수가 짧게 작별 인사를 울립니다. 조합의 운송, 쪼개지던 이윤, 붐비던 정박 구역에서 보낸 세월이 모두 뒤로 물러납니다. 원망은 없습니다. 더 큰 계획이 있을 뿐입니다.\n\n왕복선은 아무도 차지하지 않은 황야를 향해 나아가지만, 은만으로는 이곳에서 살아남을 수 없습니다. 조합은 여전히 옛 동료와 거래해 줄 것입니다. 다만 그전에, 터전이 필요합니다.</BTG_GameStartDialog_IndependentTraders>

</LanguageData>
