  <!-- ========== FLOAT MENU OPTIONS ========== -->
  <!-- EN: (requires signal jammer) -->
  <BTG_RequiresSignalJammer>(신호 교란기 필요)</BTG_RequiresSignalJammer>
  <!-- EN: requires signal jammer -->
  <BTG_RequiresSignalJammerReason>신호 교란기 필요</BTG_RequiresSignalJammerReason>
  <!-- EN: No capable negotiator -->
  <BTG_NoNegotiator>유능한 협상가 없음</BTG_NoNegotiator>
  <!-- EN: Hostile relations with {0} -->
  <BTG_TraderFactionHostile>{0}(와)과 적대 관계</BTG_TraderFactionHostile>

  <!-- ========== ADOPT DESIGNATOR ========== -->
  <!-- EN: Their people are still protecting them. -->
  <BTG_AdoptBlockedByGuardians>아직 동족이 보호하고 있습니다.</BTG_AdoptBlockedByGuardians>

