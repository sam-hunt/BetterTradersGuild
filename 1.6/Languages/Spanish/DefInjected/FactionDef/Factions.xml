  <!-- Verbatim from every Odyssey es FactionDef.messageDefendersAttacking. -->
  <!-- EN: {0} from {1} are attacking your {2}. -->
  <BTG_IndependentTraders.messageDefendersAttacking>{0} de {1} están atacando tu {2}.</BTG_IndependentTraders.messageDefendersAttacking>
