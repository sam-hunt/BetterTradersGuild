<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Japanese: ASCII punctuation throughout. Vanilla ja Core+Odyssey contain ZERO
       full-width 。 and ZERO 、 across 887k characters of translated values (Keyed and
       DefInjected alike) - it writes . and , instead. Descriptions and tooltips take
       polite です/ます and end with a period; labels, buttons and section headers take
       none. ASCII parens. Units attach tight in vanilla ja without exception
       ({0}W, {0}%, {0}x, {0}日) - unlike fr/es/pt-BR, there is no per-unit split.
       There is no LanguageWorker_Japanese: the full typedef list ships workers for 20
       languages and Japanese is not among them, and LanguageInfo.xml declares no
       languageWorkerClass, so the base worker runs and PostProcessed only merges
       repeated spaces. No elision, no contraction, no particles - nothing rewrites
       these strings, so what is written here is what ships.
       Clicked UI commands take ASCII double quotes, following Odyssey ja's own
       TheGravship game-start dialog ("惑星を見る"), which is the exact analog of the
       scenario dialogs at the bottom of this file. Corner brackets 「」 are vanilla ja's
       mark for quoted TEXT (note contents, map inscriptions), a different slot.
       Zero dashes: vanilla ja runs 6.3 em dashes per 100k chars, and BTG's English has
       none, so the two hyphens in the Independent Traders dialog are reflowed. -->

  <!-- ========== FLOAT MENU OPTIONS ========== -->
  <!-- EN: (requires signal jammer) -->
  <BTG_RequiresSignalJammer>(シグナルジャマーが必要)</BTG_RequiresSignalJammer>
  <!-- Verbatim from Odyssey ja TransportPodDestinationRequiresSignalJammer. -->
  <!-- EN: requires signal jammer -->
  <BTG_RequiresSignalJammerReason>シグナルジャマーが必要</BTG_RequiresSignalJammerReason>
  <!-- Shaped from Core ja CommandTradeFailNoNegotiator ("意識のしっかりした,まともな交渉人が
       いません."), trimmed to a label with no trailing period as the English has none. -->
  <!-- EN: No capable negotiator -->
  <BTG_NoNegotiator>まともな交渉人がいません</BTG_NoNegotiator>
  <!-- Shaped from Core ja QuestHostileTo ("{0}と敵対"). -->
  <!-- EN: Hostile relations with {0} -->
  <BTG_TraderFactionHostile>{0}と敵対関係</BTG_TraderFactionHostile>

