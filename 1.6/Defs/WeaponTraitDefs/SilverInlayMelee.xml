<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Melee counterpart of BTG's ranged SilverInlay (which follows Odyssey's Ranged-only
    GoldInlay). Gated on Unique Melee Weapons because weaponCategory references UMW's
    WeaponCategoryDef: UMW_Melee is UMW's universal melee category, so this slots into UMW's
    trait system exactly like UMW_GoldInlay/UMW_JadeInlay (add-on only, one Color-tagged
    accent per weapon) and also enters UMW's random pools for all its unique melee weapons.
    Values mirror the ranged SilverInlay 1:1. BTG spawns it deliberately on the nursery
    caretaker's knife (ShelteringCivilianSpawner). -->
  <WeaponTraitDef MayRequire="shunter.uniquemeleeweapons">
    <defName>BTG_SilverInlayMelee</defName>
    <label>silver inlay</label>
    <description>This weapon is inlaid with silver. Traders will pay more for it.</description>
    <commonality>0.5</commonality>
    <canGenerateAlone>false</canGenerateAlone>
    <weaponCategory>UMW_Melee</weaponCategory>
    <exclusionTags>
      <li>Color</li>
    </exclusionTags>
    <forcedColor>BTG_UniqueWeapon_Silver</forcedColor>
    <statOffsets>
      <Beauty>15</Beauty>
    </statOffsets>
    <statFactors>
      <MarketValue>1.7</MarketValue>
    </statFactors>
    <traitAdjectives>
      <li>silver</li>
      <li>silvered</li>
      <li>gleaming</li>
      <li>argent</li>
      <li>fine</li>
    </traitAdjectives>
  </WeaponTraitDef>

</Defs>
