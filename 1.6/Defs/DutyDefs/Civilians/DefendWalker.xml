<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Sheltering-civilian adult (caretaker), reactive self-defense posture. Assigned by
    LordToil_BTGDefend while someone is actively attacking the family and a child walker
    still needs covering; children keep BTG_EscapeWalker throughout. Strictly reactive:
    the defend giver only ever targets a pawn currently attacking a family member (see
    PartyThreatHelper), preserving the design goal that the player reads as the clear
    aggressor. When no involved attacker is reachable the duty falls through to the normal
    escape chain, so the evacuation can never stall on an unreachable shooter.
  -->
  <DutyDef>
    <defName>BTG_DefendWalker</defName>
    <!-- Deliberately NO threatDisabled here, unlike every other civilian duty: while
         covering the family's retreat the adult is an active combatant, so turrets and
         hostility-response colonists may legitimately engage. -->
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- 1. Melee the nearest pawn actively targeting a family member (adults only;
             the giver self-gates). -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGDefendParty" />
        <!-- 2-4. No reachable involved attacker: continue the escape (same chain as
             BTG_EscapeWalker). Only the adult's job is ended entering Defend (children's
             ferries continue uninterrupted); an infant the adult dropped to fight stays
             in the lord's remembered infant set wherever it lies, so any walker's carry
             scan re-finds it. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGHackShelterDoor" />
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGCarryBabyToLaunchable" />
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGBoardLaunchable" />
        <!-- 5. Blocked: hold and re-poll (see BTG_EscapeWalker node 4). -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGEscapeHold" />
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
