<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Sheltering-civilian walking child, shelter phase. Assigned by LordToil_BTGShelter.
    No combat: keeps babies tucked and fed as backup caretaker (matters when the adult
    dies - the givers gate through vanilla ChildcareUtility, so a child vanilla deems too
    young simply no-ops), then eats/sleeps (reusing the defender forage/rest givers, which
    the locked door confines to the subroom) and wanders a tight area near the caretaker.
  -->
  <DutyDef>
    <defName>BTG_ShelterChild</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- Backup baby care: normally the caretaker claims these first (reservations
             prevent double-claiming); with no adult left, a capable child takes over. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGTuckBabyInCrib" />
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGFeedBaby" />
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGForageInSubroom">
          <minCategory>Hungry</minCategory>
        </li>
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGRestInSubroom">
          <minRestCategory>Tired</minRestCategory>
        </li>
        <!-- Wander a tight area near the caretaker / subroom centre. -->
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>3</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
