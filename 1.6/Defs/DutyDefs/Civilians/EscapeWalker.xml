<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Sheltering-civilian walker (caretaker + children), escape phase. Assigned by
    LordToil_BTGEscape, which also drives the lift-off. Hack the subroom door open, carry
    infants into the best launchable (shuttle preferred, then pods), then board.
  -->
  <DutyDef>
    <defName>BTG_EscapeWalker</defName>
    <!-- Never an auto-target (see BTG_ShelterAdult for the full rationale). Also worn by
         post-defeat defenders ferrying infants (the defender lord reuses the escape
         toil), where it is what keeps the still-guild-flagged ferry from being shot. -->
    <threatDisabled>true</threatDisabled>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- 1. Open the way out: hack the locked subroom blast door. Adults only (the giver
             self-gates) - children never hack, so on a child this no-ops and the caretaker
             does it. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGHackShelterDoor" />
        <!-- 2. Carry the nearest infant into the best reachable launchable and load it. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGCarryBabyToLaunchable" />
        <!-- 3. No infant left to ferry: board the launchable yourself. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGBoardLaunchable" />
        <!-- 4. Blocked (route to the launchable momentarily impassable, or nothing
             reachable): hold position and re-poll instead of falling through to vanilla
             wander, which walks baby-carriers away from the shuttle and stalls the
             re-check for the length of the wander. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGEscapeHold" />
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
