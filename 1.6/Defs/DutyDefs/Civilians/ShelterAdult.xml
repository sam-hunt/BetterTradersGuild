<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Sheltering-civilian caretaker, shelter phase (locked crib subroom).
    Assigned by LordToil_BTGShelter. Tends the autonomous babies and eats/sleeps/wanders
    in-room. Deliberately NO combat nodes: these are non-combatants, and the design goal is
    that the player reads as the clear aggressor - when the shelter is compromised the lord
    bolts the family to the launchables (LordJob_BTGShelterCivilians.ShelterCompromised)
    instead of fighting back. Reused defender givers (forage/rest) live in
    BetterTradersGuild.AI; the shelter-specific givers in BetterTradersGuild.AI.Civilians.
  -->
  <DutyDef>
    <defName>BTG_ShelterAdult</defName>
    <!-- Non-combatants are never AUTO-targets: Pawn.ThreatDisabled honors this flag, so
         player turrets and hostility-response colonists won't open fire on the family on
         their own - attacking them stays a deliberate act (they remain faction-hostile
         and manually attackable while the garrison stands). Also makes vanilla's defeat
         test (IsDefeated -> IsActiveThreatToPlayer) ignore the family deterministically,
         instead of only while they happen to be asleep or already aboard. Also what lets
         vanilla's Claim gizmo unblock while they remain on-map:
         Thing.FactionPreventsClaimingOrAdopting blocks claiming on any faction ToolUser
         passing IsPotentialThreat, which honors this flag. Set on every civilian duty
         except BTG_DefendWalker (an actively fighting adult is a legitimate target), and
         on every mech work duty (see BTG_MechMedic). -->
    <threatDisabled>true</threatDisabled>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <!-- 1. Bottle-feed a hungry baby with the subroom's baby food. Above the tuck:
             the feed's finalizer re-cribs the baby anyway, so a hungry stray baby is
             handled in one motion instead of tucked and immediately lifted back out. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGFeedBaby" />
        <!-- 2. Put any loose/downed baby back into the nearest free crib. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGTuckBabyInCrib" />
        <!-- 3. Eat when hungry. Subroom-confined forager: self-gates on hunger (vanilla
             JobGiver_GetFood's gate lives in GetPriority, which a ThinkNode_Priority tree
             ignores) and bounds candidates to the crib subroom (focus+radius), so the
             caretaker eats the subroom shelf and won't roam if the door is breached. -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGForageInSubroom">
          <minCategory>Hungry</minCategory>
        </li>
        <!-- 4. Sleep when tired. Subroom-confined rest giver (self-gates on the rest need;
             the locked door is the primary confinement, the subroom radius the backstop). -->
        <li Class="BetterTradersGuild.AI.Civilians.JobGiver_BTGRestInSubroom">
          <minRestCategory>Tired</minRestCategory>
        </li>
        <!-- 5. Idle: wander the subroom. -->
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>4</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
