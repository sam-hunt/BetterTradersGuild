<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Better Traders Guild - Paramedic Mech Room Part

    Spawns medical mechs in MedicalBay rooms.
    Requires Biotech DLC.
  -->

  <BetterTradersGuild.RoomParts.RoomPart_MechDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>BTG_Mech_Paramedic</defName>
    <workerClass>BetterTradersGuild.RoomParts.RoomPart_Mech</workerClass>
    <pawnKindDef>Mech_Paramedic</pawnKindDef>
    <behavior>Medic</behavior>
    <!-- Medicine kit: the tend giver uses inventory medicine before searching the
         room's shelves, so the medic arrives stocked instead of depending on what
         mapgen happened to shelve. Drops as loot if the mech is killed. -->
    <startingInventory>
      <MedicineUltratech>6</MedicineUltratech>
    </startingInventory>
  </BetterTradersGuild.RoomParts.RoomPart_MechDef>

</Defs>
