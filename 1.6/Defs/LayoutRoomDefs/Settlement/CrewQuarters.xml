<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Better Traders Guild - Crew Quarters

    Crew quarters with multiple enclosed subrooms
  -->

  <LayoutRoomDef>
    <defName>BTG_CrewQuarters</defName>
    <roomContentsWorkerType>BetterTradersGuild.RoomContents.CrewQuarters.RoomContents_CrewQuarters</roomContentsWorkerType>
    <minSingleRectWidth>14</minSingleRectWidth>
    <minSingleRectHeight>11</minSingleRectHeight>

    <!-- Basic carpet flooring -->
    <floorTypes>
      <li>CarpetMarble</li>
      <li>CarpetGreyDark</li>
    </floorTypes>

    <scatter>
      <!-- Light trash from daily living -->
      <Filth_Trash>
        <groupsPerHundredCells>0~1</groupsPerHundredCells>
        <itemsPerGroup>1~2</itemsPerGroup>
        <minGroups>0</minGroups>
      </Filth_Trash>
    </scatter>

    <prefabs>
      <!-- Bed subrooms (5x5 BTG_CrewBedSubroom) spawned iteratively by RoomContents_CrewQuarters
           Places multiple subrooms along walls until no valid corner/edge placement remains -->

      <!-- Lockers for personal storage -->
      <AncientLockerBank_Row>
        <countPerTenEdgeCells>3</countPerTenEdgeCells>
        <minMaxRange>4~12</minMaxRange>
      </AncientLockerBank_Row>

    </prefabs>

    <modExtensions>
      <!-- Planting rules applied by BTG_SowPlantGrowers to the growers in this room -->
      <li Class="BetterTradersGuild.Helpers.MapGeneration.PlantGrowerRulesExtension">
        <rules>
          <!-- A different decorative plant per pot (covers pots the firefoam customizer adds) -->
          <li>
            <grower>PlantPot</grower>
            <sowTag>Decorative</sowTag>
            <perGrower>true</perGrower>
          </li>
        </rules>
      </li>

      <!-- Stocking rule applied by BTG_StockOutfitStands to the outfit stands in this room
           (the ones ShelfCustomizer swaps in for empty subroom shelves): each stand shows a
           random outfit from a crew member's wardrobe. Optional-content sets gate inline with
           MayRequire (all listed ids must be active; the loader drops the node otherwise), so
           each id appears exactly once here and the set is discoverable from this file. -->
      <li Class="BetterTradersGuild.Helpers.MapGeneration.OutfitStandRuleExtension">
        <rule>
          <sets>
            <!-- Off-duty hyperweave shirt and pants -->
            <li>
              <apparel>
                <li>Apparel_CollarShirt</li>
                <li>Apparel_Pants</li>
              </apparel>
              <stuff>Hyperweave</stuff>
            </li>
            <!-- Marine armour. Patches/LayoutRoomDef_CrewQuarters_Royalty.xml swaps this set for
                 prestige marine armour (Apparel_ArmorMarinePrestige + helmet) under Royalty. -->
            <li>
              <apparel>
                <li>Apparel_PowerArmor</li>
                <li>Apparel_PowerArmorHelmet</li>
              </apparel>
            </li>
            <!-- Siegebreaker armour (Vanilla Armour Expanded; its def names still say HeavyMarine) -->
            <li MayRequire="VanillaExpanded.VARME">
              <apparel>
                <li>VAE_Apparel_HeavyMarineArmor</li>
                <li>VAE_Headgear_HeavyMarineHelmet</li>
              </apparel>
            </li>
            <!-- Prestige vacsuit (Vanilla Gravship Expanded - Chapter 1; also from a Royalty-gated
                 load root, so both ids are required) -->
            <li MayRequire="Ludeon.RimWorld.Royalty,vanillaexpanded.gravship">
              <apparel>
                <li>VGE_Apparel_Vacsuit_Prestige</li>
                <li>VGE_Apparel_VacsuitHelmet_Prestige</li>
              </apparel>
            </li>
            <!-- Combat vacsuit (Vanilla Gravship Expanded - Chapter 2; what the mid-tier defenders
                 wear under VGE2, see Patches/PawnKinds/PawnKinds_Gunner.xml) -->
            <li MayRequire="vanillaexpanded.gravship2">
              <apparel>
                <li>VGE_Apparel_CombatVacsuit</li>
                <li>VGE_Apparel_CombatVacsuitHelmet</li>
              </apparel>
            </li>
            <!-- Panthera-leather body strap (Ideology) -->
            <li MayRequire="Ludeon.RimWorld.Ideology">
              <apparel>
                <li>Apparel_BodyStrap</li>
              </apparel>
              <stuff>Leather_Panthera</stuff>
            </li>
          </sets>
          <minQuality>Normal</minQuality>
          <maxQuality>Excellent</maxQuality>
        </rule>
      </li>
    </modExtensions>
  </LayoutRoomDef>
</Defs>