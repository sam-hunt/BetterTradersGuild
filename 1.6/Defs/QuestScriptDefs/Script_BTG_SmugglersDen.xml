<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <QuestScriptDef>
    <defName>BTG_SmugglersDen</defName>

    <rootSelectionWeight>1</rootSelectionWeight>
    <rootMinProgressScore>0</rootMinProgressScore>
    <!-- Stars are pure UI (quest log display) - vanilla never feeds challengeRating
         back into points. The siteThreatPoints curve below is what actually delivers
         the advertised difficulty, so the two must be kept in tune together. -->
    <defaultChallengeRating>3</defaultChallengeRating>
    <expireDaysRange>8~15</expireDaysRange>
    <everAcceptableInSpace>true</everAcceptableInSpace>

    <questNameRules>
      <rulesStrings>
        <li>questName->Smuggler's Den Near [settlement_label]</li>
        <li>questName->Orbital Pirate Haven</li>
        <li>questName->Salvager Outpost Near [settlement_label]</li>
        <li>questName->Black Market Station</li>
      </rulesStrings>
    </questNameRules>

    <!-- Opening line follows the Odyssey leader-quest idiom ("[asker_faction_leaderTitle]
         [asker_nameFull] of [asker_faction_name] has sent us a message.", see
         Script_OrbitalFugitive/Script_Site/Script_GravShip). askerFactionHostile is a
         slate bool set by QuestNode_GetNearestTGSettlement; the hostile variant must
         not advertise the cargo vault reward, since only goodwill is offered then. -->
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription(askerFactionHostile==False)->[asker_faction_leaderTitle] [asker_nameFull] of [asker_faction_name] has sent word of a Salvager outpost operating near [settlement_label]. The station has been intercepting Guild convoys and fencing stolen cargo.\n\nThe Guild is offering salvage rights as payment for clearing the outpost. They have a contact who can pull strings on the docking roster to stack the cargo vault and sweeten the deal.</li>
        <li>questDescription(askerFactionHostile==True)->[asker_faction_leaderTitle] [asker_nameFull] of [asker_faction_name] has sent word of a Salvager outpost operating near [settlement_label]. The station has been intercepting Guild convoys and fencing stolen cargo.\n\nThe Guild will not grant salvage rights to an enemy of theirs. Still, [asker_nameDef] hints that clearing the outpost would do much to mend your relations with the Guild.</li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- Gate: Advanced Gravtech research (signal jammer unlock) -->
        <li Class="QuestNode_RequirementsToAcceptResearch">
          <reserach>AdvancedGravtech</reserach>
        </li>

        <!-- Get player map -->
        <li Class="QuestNode_GetMap">
          <canBeSpace>true</canBeSpace>
        </li>

        <!-- Find nearest TG settlement (quest giver). A hostile TG can still give
             this quest (down-weighted, vanilla Script_BanditCamp pattern); the
             rewards node then offers goodwill only and the description drops the
             cargo vault pitch. -->
        <li Class="BetterTradersGuild.QuestNodes.QuestNode_GetNearestTGSettlement">
          <storeAs>settlement</storeAs>
          <storeFactionAs>faction</storeFactionAs>
          <storeFactionLeaderAs>asker</storeFactionLeaderAs>
          <allowHostile>true</allowHostile>
        </li>

        <!-- Threat scaling: wealth -> site threat points, delivered to the garrison
             and sentry drones through SitePartParams.threatPoints (see
             GenStepDefs/SmugglersDenDefenders.xml). Tuned for the 3-star rating:
             vanilla's Util_RandomizePointsChallengeRating prices 3 stars at ~1.5x
             the 2-star budget, so this is the old 2-star curve scaled by 1.5. -->
        <li Class="QuestNode_GetMapWealth">
          <map>$map</map>
          <storeAs>mapWealth</storeAs>
        </li>
        <li Class="QuestNode_EvaluateSimpleCurve">
          <value>$mapWealth</value>
          <storeAs>siteThreatPoints</storeAs>
          <curve>
            <points>
              <li>0, 1200</li>
              <li>100000, 2400</li>
              <li>300000, 4800</li>
            </points>
          </curve>
        </li>

        <!-- Create smuggler's den site (deferred to quest acceptance) -->
        <li Class="BetterTradersGuild.QuestNodes.QuestNode_BTG_SmugglersDen_CreateSite">
          <storeAs>site</storeAs>
          <nearSettlement>$settlement</nearSettlement>
        </li>

        <!-- Reward choices: 2 cargo vault types + goodwill (goodwill only when
             the TG is hostile) -->
        <li Class="BetterTradersGuild.QuestNodes.QuestNode_BTG_SmugglersDen_Rewards">
          <site>$site</site>
          <faction>$faction</faction>
          <traderTypeCount>2</traderTypeCount>
        </li>

        <!-- Deliberately NO fail on faction.BecameHostileToPlayer: the den is a
             Salvagers site, so TG hostility doesn't make it uncompletable, and an
             early quest end destroys the site (QuestPart_DestroyWorldObject on End)
             out from under the player. Vanilla opportunity sites carry no hostility
             fail either (Script_BanditCamp even allows a hostile asker) - and since
             allowHostile above, neither does the offer: a hostile TG offers the
             quest too, just rarely and for goodwill only. -->

        <!-- Timeout, for a quest accepted but never engaged. Disarmed permanently
             once the den map generates (vanilla opportunity-site idiom, see
             Script_BanditCamp): without the disable, the timeout could fire mid-raid
             and destroy the site before the player finishes clearing it. Leaving
             without clearing is still a fail via site.Destroyed below. -->
        <li Class="QuestNode_Delay">
          <delayTicks>$(randInt(8,15)*60000)</delayTicks>
          <isQuestTimeout>true</isQuestTimeout>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <outSignalComplete>SmugglersDenTimeout</outSignalComplete>
        </li>

        <!-- Completion: all enemies defeated -->
        <li Class="QuestNode_End">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <outcome>Success</outcome>
          <sendStandardLetter>true</sendStandardLetter>
        </li>

        <!-- Failure: player entered and left without clearing the site.
             The site (and its map) is removed when the player leaves, so the
             quest can no longer be completed. Same pattern as Script_BanditCamp. -->
        <li Class="QuestNode_Letter">
          <inSignal>site.Destroyed</inSignal>
          <label TKey="BTG_LetterLabel_SmugglersDenAbandoned">Quest failed: [resolvedQuestName]</label>
          <text TKey="BTG_LetterText_SmugglersDenAbandoned">Alerted to the attack, the Salvagers have stripped the outpost and scattered. The quest [resolvedQuestName] has ended.</text>
        </li>
        <li Class="QuestNode_End">
          <inSignal>site.Destroyed</inSignal>
          <outcome>Fail</outcome>
        </li>

        <!-- Failure: timeout -->
        <li Class="QuestNode_End">
          <inSignal>SmugglersDenTimeout</inSignal>
          <outcome>Fail</outcome>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
