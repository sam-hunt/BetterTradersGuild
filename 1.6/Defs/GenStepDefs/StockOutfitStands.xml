<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Better Traders Guild - Stock Outfit Stands GenStep

    Stocks every empty outfit stand on the map. Rooms built by the platform step are
    dressed first from the OutfitStandRuleExtension on their LayoutRoomDefs (see
    LayoutRoomDefs/Settlement/{Armory,Corridor,CrewQuarters}.xml); the rule below is the
    map-wide default for whatever no room rule covered, which is every stand on stations
    BTG did not author (VGE2's Traders Guild station leaves its steel stands empty) and any
    stray stand on BTG's own maps. Stands already holding anything are skipped.

    Rule fields (BetterTradersGuild.Helpers.MapGeneration.OutfitStandRule):
    - sets: candidate outfits; a stocked stand gets one of each item of exactly one set,
      with an optional set-level stuff for the stuffable pieces
    - chancePerStand: probability an empty stand is stocked (default 1)
    - minQuality / maxQuality: uniform quality roll per item (default Normal~Excellent)
    - perStand: pick a set per stand (true, default) or one set for all (false)

    The default mirrors the corridor airlock policy (half the stands, a Normal/Good vacsuit)
    so a station whose rooms BTG did not author reads the same as BTG's airlocks.
  -->

  <GenStepDef>
    <defName>BTG_StockOutfitStands</defName>
    <order>315</order>
    <genStep Class="BetterTradersGuild.MapGeneration.GenStep_StockOutfitStands">
      <rule>
        <sets>
          <li>
            <apparel>
              <li>Apparel_Vacsuit</li>
              <li>Apparel_VacsuitHelmet</li>
            </apparel>
          </li>
        </sets>
        <chancePerStand>0.5</chancePerStand>
        <minQuality>Normal</minQuality>
        <maxQuality>Good</maxQuality>
      </rule>
    </genStep>
  </GenStepDef>
</Defs>
