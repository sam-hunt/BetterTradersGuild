<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Smuggler's Den Map Generator

    Custom MapGeneratorDef for smuggler's den quest sites.
    Reuses most GenSteps from BTG_SettlementMapGenerator with these differences:
    - BTG_SmugglersDenPlatform: Forked layout (no nursery/classroom, required armory)
    - BTG_ReplaceTerrain/BTG_PaintTerrain skipped: keeps the aged AncientTile floors
      for a run-down look
    - BTG_SmugglersDenWallLampColor: corridor and armory lamps glow red
    - BTG_GenerateQuestVaultStock: Pre-populates vault stock from quest reward choice
    - Defenders (pawns + sentry drones) are NOT listed here: they run via the
      linkWithSite GenStepDefs in GenStepDefs/SmugglersDenDefenders.xml so they
      receive GenStepParams.sitePart and its quest-computed threatPoints
  -->

  <MapGeneratorDef ParentName="SpaceMapGenerator">
    <defName>BTG_SmugglersDenMapGenerator</defName>
    <label>smuggler's den platform</label>

    <!-- Defeat itself is decided by BTG's SiteCheckAllEnemiesDefeated patch
         (SecurityDefeatUtility threshold), which ignores fog and reachability by
         design - defenders behind locked subroom doors still count. This flag only
         shapes vanilla GenHostility.IsPotentialThreat for its remaining consumers
         (e.g. the NoActiveThreats site signal): keep enemies in unreachable fogged
         areas counting as threats there too, for consistency. -->
    <defeatRequiresCantReachUnfogged>false</defeatRequiresCantReachUnfogged>

    <genSteps>
      <!-- Core platform generation using forked smuggler's den layout -->
      <li>BTG_SmugglersDenPlatform</li>     <!-- order 200 -->

      <!-- Under VGE2, two corner cannons become live VGE_EnemyGaussCannons owned by the den -->
      <li MayRequire="vanillaexpanded.gravship2">BTG_SwapPlatformCannons_VGE2</li> <!-- order 205 -->

      <!-- Static post-processing -->
      <!-- BTG_ReplaceTerrain skipped for run-down look -->
      <!-- BTG_PaintTerrain skipped for run-down look -->
      <li>BTG_ExtendLandingPadPipes</li>     <!-- order 260 -->
      <li>BTG_SmugglersDenWallLampColor</li> <!-- order 265; red corridor/armory lamps -->

      <!-- Plant every empty grower from the room defs' planting rules, then the map defaults -->
      <li>BTG_SowPlantGrowers</li>        <!-- order 310 -->

      <!-- Dress every empty outfit stand from the room defs' stocking rules, then the map default -->
      <li>BTG_StockOutfitStands</li>       <!-- order 315 -->

      <!-- Pre-populate vault stock from quest reward choice -->
      <li>BTG_GenerateQuestVaultStock</li>   <!-- order 698 -->

      <!-- Defenders spawn via linkWithSite GenStepDefs (orders 700/705), not here:
           see GenStepDefs/SmugglersDenDefenders.xml -->
    </genSteps>

  </MapGeneratorDef>
</Defs>
