<LanguageData>

  <!-- The guild shuttle defs (1.6/Mods/VanillaGravshipExpanded2/Defs/ThingDefs) wear VGE2's
       locked-shuttle art, so they load only from this LoadFolders-gated compat root. Their
       injections must live here too: MayRequire is honored on defs but IGNORED on DefInjected
       entries, so a main-tree injection would log a found-no-def error for every user without
       VGE2 installed. -->

  <!-- EN: guild shuttle -->
  <BTG_GuildShuttle.label>Gildenraumfähre</BTG_GuildShuttle.label>
  <!-- EN: A chemfuel-powered shuttle designed for long-distance travel, built to the pattern the Traders Guild uses across its stations. Its magnetic clamps have been overridden, and it is capable of reaching orbital locations. -->
  <BTG_GuildShuttle.description>Eine mit Sprit betriebene Raumfähre, ausgelegt für Langstreckenreisen und gebaut nach dem Muster, das die Händlergilde in ihren Stationen verwendet. Ihre Magnetklammern wurden übersteuert, sodass sie Orbitalstandorte erreichen kann.</BTG_GuildShuttle.description>
  <!-- EN: Chemfuel -->
  <BTG_GuildShuttle.comps.CompRefuelable.fuelLabel>Sprit</BTG_GuildShuttle.comps.CompRefuelable.fuelLabel>
  <!-- EN: Chemfuel -->
  <BTG_GuildShuttle.comps.CompRefuelable.fuelGizmoLabel>Sprit</BTG_GuildShuttle.comps.CompRefuelable.fuelGizmoLabel>
