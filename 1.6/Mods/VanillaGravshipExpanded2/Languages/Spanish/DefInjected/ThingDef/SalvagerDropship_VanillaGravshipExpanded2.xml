<LanguageData>

  <!-- The salvager dropship defs (1.6/Mods/VanillaGravshipExpanded2/Defs/ThingDefs) wear
       VGE2's dropship art, so they load only from this LoadFolders-gated compat root and
       their injections must live here too (see GuildShuttle_VanillaGravshipExpanded2.xml).
       The incoming/leaving skyfallers are VGE2's own defs, so they have no BTG strings. -->

  <!-- BTG_SalvagerDropship -->
  <!-- EN: salvager dropship -->
  <BTG_SalvagerDropship.label>nave de desembarco de chatarreros</BTG_SalvagerDropship.label>
  <!-- EN: A chemfuel-powered, heavily armored dropship built by salvagers for incursions into enemy territory. Its flight lockout has been bypassed, and it is capable of reaching orbital locations. -->
  <BTG_SalvagerDropship.description>Una nave de desembarco impulsada por biocombustible y fuertemente blindada, construida por chatarreros para penetrar en territorio enemigo. Su bloqueo de vuelo ha sido burlado, y es capaz de alcanzar ubicaciones en órbita.</BTG_SalvagerDropship.description>
  <!-- EN: Chemfuel -->
  <BTG_SalvagerDropship.comps.CompRefuelable.fuelLabel>Biocombustible</BTG_SalvagerDropship.comps.CompRefuelable.fuelLabel>
  <!-- EN: Chemfuel -->
  <BTG_SalvagerDropship.comps.CompRefuelable.fuelGizmoLabel>Biocombustible</BTG_SalvagerDropship.comps.CompRefuelable.fuelGizmoLabel>
  <!-- The GuildShuttle precedent ("{0} está listo...") would mis-agree with this feminine noun, so the verb frame is invariant. -->
  <!-- EN: {0} is ready to launch again. -->
  <BTG_SalvagerDropship.comps.CompLaunchable.cooldownEndedMessage>{0} puede lanzarse de nuevo.</BTG_SalvagerDropship.comps.CompLaunchable.cooldownEndedMessage>

