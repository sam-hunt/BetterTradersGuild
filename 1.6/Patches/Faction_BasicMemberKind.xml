<?xml version="1.0" encoding="utf-8"?>
<!--
  Better Traders Guild - TradersGuild basicMemberKind Patch

  Adds basicMemberKind to the TradersGuild FactionDef.

  The Odyssey DLC doesn't define basicMemberKind for TradersGuild (or Salvagers);
  vanilla null-checks it, but every other faction sets it, so third-party code
  routinely assumes it is non-null. Humanoid Alien Races (HAR) used to read
  faction.def.basicMemberKind.race in Comp_OutfitStandHAR.PostSpawnSetup and threw
  a NullRef on every TradersGuild-owned Building_OutfitStand. HAR fixed that upstream
  on 2026-09-07 (AlienRaces ae8412c, BasicPawnKindOfFaction fallback); this patch
  stays as cover for older HAR builds and any other mod with the same assumption,
  and it makes HAR resolve the stand race deterministically instead of rolling a
  random pawnGroupMaker kind.

  TradersGuild_Citizen is the natural choice as the faction's basic member kind.
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName="TradersGuild"]/basicMemberKind</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/FactionDef[defName="TradersGuild"]</xpath>
      <value>
        <basicMemberKind>TradersGuild_Citizen</basicMemberKind>
      </value>
    </nomatch>
  </Operation>
</Patch>
