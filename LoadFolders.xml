<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!--
    LoadFolders.xml - Tells RimWorld which folders to load based on game version.

    This mod requires RimWorld 1.6+ (Odyssey DLC).
    Version-specific content (Assemblies, Defs, Patches) lives in the 1.6/ folder.
    The root "/" loads About/ and other shared metadata, rather than everything,
    since RimWorld only looks for well-known folders within these directories
  -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!-- Optional-mod compat roots live under 1.6/Mods/<Mod Name>/, one gated entry
         each (the layout the wider ecosystem uses). Needed whenever content can't
         gate itself: defs support MayRequire, but DefInjected entries do not (the
         loader ignores attributes on them). Safe to nest inside 1.6 because the
         game only scans well-known folders (Languages/, Defs/, ...) directly under
         a load root, so the plain 1.6 entry above never sees Mods/. -->
    <li IfModActive="shunter.uniquemeleeweapons">1.6/Mods/UniqueMeleeWeapons</li>
    <li IfModActive="ludeon.rimworld.biotech">1.6/Mods/Biotech</li>
  </v1.6>
</loadFolders>
