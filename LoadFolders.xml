<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!--
    LoadFolders.xml - Tells RimWorld which folders to load based on game version.

    This mod requires RimWorld 1.6+ (Odyssey DLC).
    Version-specific content (Assemblies, Defs, Patches) lives in the 1.6/ folder.
    The root "/" loads About/ and other shared metadata, rather than everything,
    since RimWorld only looks for well-known folders within these directories
  -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!-- Content that must only load alongside Unique Melee Weapons. Defs can gate
         themselves with MayRequire, but DefInjected entries cannot (the loader
         ignores attributes on them), so UMW-dependent language files live here. -->
    <li IfModActive="shunter.uniquemeleeweapons">1.6_UMW</li>
  </v1.6>
</loadFolders>
